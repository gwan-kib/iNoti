{
  "manifest_version": 3,
  "minimum_chrome_version": "123",
  "name": "iNoti",
  "version": "0.1.0",
  "description": "Visual/audio notifications for iClicker questions.",
  "permissions": [
    "webNavigation",
    "storage",
    "offscreen"
  ],
  "icons": {
    "128": "assets/inoti-logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://student.iclicker.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "iNoti",
    "default_popup": "popup/popup.html"
  }
}
